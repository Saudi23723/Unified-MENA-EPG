<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="170dp" android:layout_height="170dp" android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
    android:background="@drawable/tile_bg" android:focusable="true" android:clickable="true"
    android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="54sp" android:duplicateParentState="true"/>
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textSize="19sp" android:textStyle="bold" android:duplicateParentState="true"/>
</LinearLayout>
