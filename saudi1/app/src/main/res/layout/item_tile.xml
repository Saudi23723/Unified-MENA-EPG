<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="104dp" android:layout_height="128dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
    android:background="@drawable/tile_bg" android:focusable="true" android:clickable="true"
    android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="38sp" android:duplicateParentState="true"/>
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="14sp" android:maxLines="1" android:textStyle="bold" android:duplicateParentState="true"/>
</LinearLayout>
