<?xml version="1.0" encoding="utf-8"?>
<!-- the focused row of a dialog list: a soft green rounded bar with a green edge -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_focused="true"><inset android:insetLeft="8dp" android:insetRight="8dp" android:insetTop="2dp" android:insetBottom="2dp">
        <shape><solid android:color="#4010B981" /><stroke android:width="2dp" android:color="#FF10B981" /><corners android:radius="12dp" /></shape></inset></item>
    <item android:state_selected="true"><inset android:insetLeft="8dp" android:insetRight="8dp" android:insetTop="2dp" android:insetBottom="2dp">
        <shape><solid android:color="#4010B981" /><stroke android:width="2dp" android:color="#FF10B981" /><corners android:radius="12dp" /></shape></inset></item>
    <item android:state_pressed="true"><inset android:insetLeft="8dp" android:insetRight="8dp" android:insetTop="2dp" android:insetBottom="2dp">
        <shape><solid android:color="#6610B981" /><corners android:radius="12dp" /></shape></inset></item>
    <item android:drawable="@android:color/transparent" />
</selector>
