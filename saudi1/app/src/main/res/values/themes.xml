<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowAnimationStyle">@style/FastScreens</item>
        <item name="alertDialogTheme">@style/ModernDialog</item>
    </style>
    <!-- every AlertDialog left in the app (Multiview, Settings...): dark, rounded, green focus, like the new player menus -->
    <style name="ModernDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#B3FFFFFF</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="colorAccent">#FF10B981</item>
        <item name="colorControlActivated">#FF10B981</item>
        <item name="colorControlNormal">#B3FFFFFF</item>
        <item name="android:listSelector">@drawable/dialog_item</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/dialog_item</item>
        <item name="selectableItemBackground">@drawable/dialog_item</item>
        <item name="android:windowMinWidthMajor">42%</item>
        <item name="android:windowMinWidthMinor">60%</item>
        <item name="buttonBarButtonStyle">@style/ModernDialogButton</item>
    </style>
    <style name="ModernDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#FF10B981</item>
        <item name="android:background">@drawable/dialog_item</item>
    </style>
    <!-- screens: the new one fades in over the old one (170 ms), going back it fades out -->
    <style name="FastScreens" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fast_in</item>
        <item name="android:activityOpenExitAnimation">@anim/stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/stay</item>
        <item name="android:activityCloseExitAnimation">@anim/fast_out</item>
    </style>
</resources>
