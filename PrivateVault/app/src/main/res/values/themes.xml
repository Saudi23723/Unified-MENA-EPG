<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The day look: light ground, white cards, the same clear blue. -->
    <style name="Theme.Vault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#FF1A6FE0</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorPrimaryContainer">#FFDCE9FF</item>
        <item name="colorOnPrimaryContainer">#FF0A2A55</item>
        <item name="colorSecondary">#FF1A6FE0</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorSecondaryContainer">#FFE3ECFA</item>
        <item name="colorOnSecondaryContainer">#FF14284A</item>
        <item name="colorTertiary">#FF1E9E4A</item>
        <item name="colorError">#FFD93025</item>
        <item name="android:colorBackground">#FFF4F6F9</item>
        <item name="colorSurface">#FFF4F6F9</item>
        <item name="colorOnSurface">#FF111827</item>
        <item name="colorOnSurfaceVariant">#FF5B6573</item>
        <item name="colorSurfaceVariant">#FFFFFFFF</item>
        <item name="colorSurfaceContainerLowest">#FFFFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFAFBFC</item>
        <item name="colorSurfaceContainer">#FFFFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFF0F2F5</item>
        <item name="colorSurfaceContainerHighest">#FFE8EBF0</item>
        <item name="colorOutline">#FFC5CCD6</item>
        <item name="colorOutlineVariant">#FFE2E6EC</item>
        <item name="android:statusBarColor">#FFF4F6F9</item>
        <item name="android:navigationBarColor">#FFF4F6F9</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="HudCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FF7CFC00</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Vault.Fullscreen" parent="Theme.Vault">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
